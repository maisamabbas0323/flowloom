# Flowloom configuration
# ----------------------
# Copy this file to `.env` in the same directory and fill in what you use.
# Values here apply whenever the equivalent "saved override" has NOT been set
# in the app's Settings screen. Settings always win; clearing a saved override
# makes the value below effective again.
#
# Never commit a real `.env` file — it is git-ignored on purpose.

# --- Language engine -------------------------------------------------
# Which language engine to use: google | openrouter | ollama
FLOWLOOM_MODEL_PROVIDER=

# The exact model identifier as supplied by your provider, e.g. a Gemma
# model id from Google AI, OpenRouter (vendor/model), or your Ollama tag.
# No default is invented — you must supply this yourself.
FLOWLOOM_MODEL_ID=

# Google AI API key (aistudio.google.com)
GOOGLE_API_KEY=

# OpenRouter API key (openrouter.ai)
OPENROUTER_API_KEY=

# Base URL of a locally running Ollama server, e.g. http://127.0.0.1:11434
# Optional API key, only needed if your Ollama endpoint requires auth.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# --- Voice -----------------------------------------------------------
# ElevenLabs API key and the voice ID you want to use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Browser automation ----------------------------------------------
# Browserbase API key and project id (browserbase.com)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Paper Instruments ------------------------------------------------
# Paper Instruments (Ultramarine API) live key, format pi_live_…
PAPERINSTRUMENTS_API_KEY=

# The exact model id from GET /v1/models — never invented or guessed.
PAPERINSTRUMENTS_MODEL=
